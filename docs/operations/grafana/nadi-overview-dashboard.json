{
    "id": null,
    "uid": "nadi-overview",
    "title": "NADI Infrastructure Overview",
    "tags": [
        "nadi",
        "infrastructure",
        "server-monitoring",
        "application-monitoring"
    ],
    "timezone": "browser",
    "schemaVersion": 39,
    "version": 1,
    "refresh": "30s",
    "time": {
        "from": "now-6h",
        "to": "now"
    },
    "editable": false,
    "graphTooltip": 1,
    "templating": {
        "list": [
            {
                "name": "hostname",
                "label": "Server",
                "type": "query",
                "datasource": {
                    "type": "prometheus",
                    "uid": "nadi-prometheus"
                },
                "refresh": 1,
                "query": {
                    "query": "label_values(nadi_server_cpu_usage_percent, hostname)",
                    "refId": "StandardVariableQuery"
                },
                "definition": "label_values(nadi_server_cpu_usage_percent, hostname)",
                "includeAll": true,
                "allValue": ".*",
                "multi": true,
                "sort": 1,
                "current": {
                    "selected": true,
                    "text": [
                        "All"
                    ],
                    "value": [
                        "$__all"
                    ]
                }
            }
        ]
    },
    "panels": [
        {
            "id": 1,
            "title": "CPU Usage by Server",
            "type": "timeseries",
            "datasource": {
                "type": "prometheus",
                "uid": "nadi-prometheus"
            },
            "gridPos": {
                "x": 0,
                "y": 0,
                "w": 12,
                "h": 8
            },
            "fieldConfig": {
                "defaults": {
                    "unit": "percent",
                    "color": {
                        "mode": "palette-classic"
                    },
                    "custom": {
                        "drawStyle": "line",
                        "lineInterpolation": "smooth",
                        "lineWidth": 2,
                        "fillOpacity": 12,
                        "showPoints": "never",
                        "spanNulls": false
                    }
                },
                "overrides": []
            },
            "options": {
                "legend": {
                    "displayMode": "list",
                    "placement": "bottom",
                    "showLegend": true
                },
                "tooltip": {
                    "mode": "multi",
                    "sort": "desc"
                }
            },
            "targets": [
                {
                    "datasource": {
                        "type": "prometheus",
                        "uid": "nadi-prometheus"
                    },
                    "editorMode": "code",
                    "expr": "avg by (hostname) (nadi_server_cpu_usage_percent{hostname=~\"$hostname\"})",
                    "legendFormat": "{{hostname}}",
                    "refId": "A"
                }
            ]
        },
