global:
    resolve_timeout: 5m

route:
    receiver: nadi-central-webhook
    group_by:
        - alertname
        - instance
    group_wait: 30s
    group_interval: 5m
    repeat_interval: 4h

receivers:
    - name: nadi-central-webhook
      webhook_configs:
          - url: https://nadi.pesantrenalirsyad.org/api/v1/nadi/alertmanager/webhook
            send_resolved: true
            max_alerts: 200
            timeout: 10s
            http_config:
                bearer_token_file: /etc/alertmanager/secrets/nadi-central-webhook-token
